---
import {imageUrl, renderBody} from '../content/sanity-post.mjs';
import 'highlight.js/styles/github-dark.css';

// Receives an already fetched post; no Sanity request is made by this component.
const {post, locale = 'en'} = Astro.props;
const cover = imageUrl(post.cover);
const related = (post.relatedArticles || []).filter((item) => item?.slug?.current && item._id !== post._id);
---
<article class="sanity-article">
  <header>
    {post.kicker && <p class="sanity-kicker">{post.kicker}</p>}
    <h1>{post.title}</h1>
    {post.subtitle && <p class="sanity-subtitle">{post.subtitle}</p>}
    {post.publishedAt && <time datetime={post.publishedAt}>{new Intl.DateTimeFormat(locale, {dateStyle: 'long', timeZone: 'UTC'}).format(new Date(post.publishedAt))}</time>}
  </header>
  {cover && <figure><img src={cover} alt={post.cover.alt || ''} width={post.cover.asset?.dimensions?.width} height={post.cover.asset?.dimensions?.height} decoding="async" />{post.cover.caption && <figcaption>{post.cover.caption}</figcaption>}</figure>}
  <div class="sanity-body" set:html={renderBody(post.body)} />
  {related.length > 0 && <section class="sanity-related"><h2>{locale === 'es' ? 'Artículos relacionados' : 'Related articles'}</h2><ul>{related.map((item) => <li><a href={`/${encodeURIComponent(locale)}/blog/${encodeURIComponent(item.slug.current)}/`}>{item.title}</a>{item.subtitle && <p>{item.subtitle}</p>}</li>)}</ul></section>}
</article>
<style>
  .sanity-article {max-width: 720px; margin: 0 auto; padding: 2rem 1rem; overflow-wrap: anywhere;}
  .sanity-article :global(figure) {margin: 2rem 0;}
  .sanity-article :global(img) {display: block; width: 100%; height: auto;}
  .sanity-article :global(figcaption) {margin-top: .5rem; font-size: .875rem; opacity: .8;}
  .sanity-body {line-height: 1.75;}
  .sanity-body :global(blockquote) {margin: 1.5rem 0; padding-left: 1rem; border-left: 3px solid currentColor;}
  .sanity-body :global(.sanity-pullquote) {border: 0; padding: 0; text-align: center; font-size: 1.5em;}
  .sanity-body :global(pre), .sanity-body :global(.sanity-table) {overflow-x: auto; max-width: 100%;}
  .sanity-body :global(pre) {padding: 1rem; border: 1px solid color-mix(in srgb,currentColor 28%,transparent); background: #0d1117; color: #e6edf3;}
  .sanity-body :global(table) {border-collapse: collapse; min-width: 100%; border: 1px solid color-mix(in srgb,currentColor 35%,transparent);}
  .sanity-body :global(th), .sanity-body :global(td) {border-bottom: 1px solid color-mix(in srgb,currentColor 28%,transparent); padding: .65rem; text-align:left;}
  .sanity-related {margin-top: 3rem; border-top:1px solid color-mix(in srgb,currentColor 25%,transparent); padding-top:2rem;}
  .sanity-related ul {display:grid; gap:.75rem; margin:1rem 0 0; padding:0; list-style:none;}
  .sanity-related li {padding:1rem; border:1px solid color-mix(in srgb,currentColor 25%,transparent);}
  .sanity-related li:hover {border-color:currentColor; background:color-mix(in srgb,currentColor 5%,transparent);}
  .sanity-subtitle {font-size: 1.25rem;}
</style>
