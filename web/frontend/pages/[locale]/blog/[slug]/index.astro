---
import type { GetStaticPaths } from 'astro';
import ArticleLayout from '../../../../layouts/ArticleLayout.astro';
import ArticleBody from '../../../../components/ArticleBody.astro';
import RelatedArticles from '../../../../components/RelatedArticles.astro';
import { contentProvider } from '../../../../content';
import type { Article, Locale } from '../../../../content';
import ContentImage from '../../../../components/ContentImage.astro';
import { findingNouns as text } from '../../../../../src/lib/wording.mjs';
import { SITE } from '../../../../../src/config/site.mjs';
import { ARTICLE_UI } from '../../../../../src/locales/articles.mjs';

export const getStaticPaths = (async () => {
  const locales = SITE.locales as Locale[];
  return (await Promise.all(locales.map(async locale => {
    const catalog = await contentProvider.listArticles(locale);
    return catalog.map(article => ({ params: { locale, slug: article.slug }, props: { article, catalog, locale } }));
  }))).flat();
}) satisfies GetStaticPaths;

interface Props { article: Article; catalog: readonly Article[]; locale: Locale }
const { article, catalog, locale } = Astro.props;
const labels = ARTICLE_UI[locale];
---
<ArticleLayout locale={locale} article={article}>
  <main class="article-main">
    <a class="article-back" href={`/${locale}/blog/`}>{labels.back}</a>
    <article>
      <header class="article-header">
        <div class="article-meta"><span class="article-type">{labels.kinds[article.type]}</span><time class="article-date" datetime={article.isoDate}>{article.date}</time></div>
        {article.kicker && <p>{article.kicker}</p>}<h1>{text(article.title)}</h1><p class="article-dek">{text(article.dek)}</p>
      </header>
      <figure class="article-hero"><ContentImage file={article.image} alt={article.alt} width={article.width} height={article.height} priority />{article.coverCaption && <figcaption>{article.coverCaption}</figcaption>}</figure>
      <ArticleBody blocks={article.blocks} body={article.body} />
      {article.sources?.length && <section class="article-body article-sources" aria-labelledby="article-sources-title">
        <h2 id="article-sources-title">{locale === 'es' ? 'Fuentes' : 'Sources'}</h2>
        <ul>{article.sources.map(source => <li><a href={source.url}>{source.label}</a></li>)}</ul>
      </section>}
    </article>
    <RelatedArticles article={article} catalog={catalog} locale={locale} />
  </main>
</ArticleLayout>
